{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    /* Strictness */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,

    /* Critical fix: override Expo's invalid setting */
    "module": "ESNext",
    "moduleResolution": "bundler",

    /* Interop */
    "resolveJsonModule": true,
    "allowJs": true,
    "isolatedModules": true,

    /* JSX */
    "jsx": "react-jsx",

    /* Paths */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },

    /* Explicit global types */
    "types": [
      "node",
      "react",
      "react-native",
      "jest"
    ],

    /* Sanity */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* No emit (Expo handles builds) */
    "noEmit": true
  },

  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts"
  ],

  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "vite.config.ts"
  ]
}
