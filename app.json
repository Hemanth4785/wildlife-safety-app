{
  "expo": {
    "name": "Wildlife Safety",
    "slug": "wildlife-safety",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#059669"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wildlifesafety.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#059669"
      },
      "package": "com.wildlifesafety.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Wildlife Safety to use your location to provide safe route predictions."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Wildlife Safety to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow Wildlife Safety to recognize your speech.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "updates": {
      "checkOnLaunch": "never",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "API_BASE_URL": "http://localhost:3000",
      "OPENAI_API_KEY": "",
      "OPENAI_MODEL": "gpt-3.5-turbo"
    }
  }
}
