rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profiles: Users can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Animal Sightings: Only authenticated users can access
    match /animal_sightings/{sightingId} {
      allow read, write: if request.auth != null;
    }
    
    // Animals master: Authenticated users can read; writes allowed for authenticated (app-controlled)
    match /animals/{scientificId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Reports: Only authenticated users can read/write their submissions
    match /reports/{reportId} {
      allow read, write: if request.auth != null;
    }
    
    // Default: Deny everything else
    match /{document=**} {
      allow read, write: false;
    }
  }
}
