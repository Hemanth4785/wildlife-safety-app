{
  "expo": {
    "name": "Wildlife Safety",
    "slug": "wildlife-safety",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#059669"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wildlifesafety.app"
    },
    "android": {
      "permissions": [
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#059669"
      },
      "package": "com.wildlifesafety.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDummyKeyForNativeInitializationOnly"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Wildlife Safety to use your location to provide safe route predictions."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Wildlife Safety to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow Wildlife Safety to recognize your speech.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "OPENAI_API_KEY": "",
      "OPENAI_MODEL": "gpt-3.5-turbo",
      "GEMINI_API_KEY": "",
      "GEMINI_MODEL": "gemini-1.5-flash",
      "eas": {
        "projectId": "2eff998a-4ea6-476e-a02a-5702bf0d01e1"
      },
      "NODE_ENV": "development",
      "API_BASE_URL": "https://wildlife-safety-api.onrender.com/api",
      "ML_SERVICE_URL": "https://wildlife-safety-app-1.onrender.com"
    },
    "owner": "hemanth977"
  }
}
